test "DP-01" {
    given {
        context {
            decision_time @2026-08-26T12:00:00+05:00;
            knowledge_time @2026-08-26T12:00:00+05:00;
            legal_time @1879-06-01;
            timezone "Asia/Qyzylorda";
        }

        assert obvinyon(entity_ref("urn:ru:dal:clir:poslovitsy#Emelyan"), entity_ref("urn:ru:dal:clir:poslovitsy#Delo1")) {
            id "assert-a0";
            origin case_input;
        }

        assert osuzhden_sudom(entity_ref("urn:ru:dal:clir:poslovitsy#Emelyan"), entity_ref("urn:ru:dal:clir:poslovitsy#Delo1")) {
            id "assert-a1";
            origin case_input;
        }
    }

    evaluate truth(kazn_dopustima(entity_ref("urn:ru:dal:clir:poslovitsy#Emelyan"), entity_ref("urn:ru:dal:clir:poslovitsy#Delo1")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);
    expect any_applied(PoSuduKaznyat);
}

