language "law.core" version "0.1";
package ru.dal.poslovitsy version "0.2.0";
namespace "urn:ru:dal:clir:poslovitsy";

test "urn:query:dp-rodovaya-otvetstvennost-bez-starogo-obychaya" {
    given {
        context { decision_time @2026-08-31T12:00:00Z; knowledge_time @2026-08-31T12:00:00Z; legal_time @1879-06-01; timezone "UTC"; }
        assert v_dele(entity_ref("urn:ru:dal:clir:poslovitsy#Frol"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloODolge")) { id "dp05b-1"; origin case_input; }
        assert brat(entity_ref("urn:ru:dal:clir:poslovitsy#Stepan"), entity_ref("urn:ru:dal:clir:poslovitsy#Frol")) { id "dp05b-2"; origin case_input; }
    }
    evaluate truth(v_otvete(entity_ref("urn:ru:dal:clir:poslovitsy#Stepan"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloODolge")));
    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
