language "law.core" version "0.1";
package ru.dal.poslovitsy version "0.2.0";
namespace "urn:ru:dal:clir:poslovitsy";

test "urn:query:dp-proshchennaya-vina-ne-karaetsya" {
    given {
        context { decision_time @2026-08-31T12:00:00Z; knowledge_time @2026-08-31T12:00:00Z; legal_time @1879-06-01; timezone "UTC"; }
        assert vinoven(entity_ref("urn:ru:dal:clir:poslovitsy#Kuzma"), entity_ref("urn:ru:dal:clir:poslovitsy#Delo1")) { id "dp26-1"; origin case_input; }
        assert vina_proshchena(entity_ref("urn:ru:dal:clir:poslovitsy#Kuzma"), entity_ref("urn:ru:dal:clir:poslovitsy#Delo1")) { id "dp26-2"; origin case_input; }
    }
    evaluate truth(podlezhit_kare(entity_ref("urn:ru:dal:clir:poslovitsy#Kuzma"), entity_ref("urn:ru:dal:clir:poslovitsy#Delo1")));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
