language "law.core" version "0.1";
package ru.dal.poslovitsy version "0.2.0";
namespace "urn:ru:dal:clir:poslovitsy";

test "urn:query:dp-neizvestnost-oplaty-ne-neuplata" {
    given {
        context { decision_time @2026-08-31T12:00:00Z; knowledge_time @2026-08-31T12:00:00Z; legal_time @1879-06-01; timezone "UTC"; }
        assert ugovor_zaklyuchen(entity_ref("urn:ru:dal:clir:poslovitsy#Makar"), entity_ref("urn:ru:dal:clir:poslovitsy#Savva"), entity_ref("urn:ru:dal:clir:poslovitsy#SdelkaOLoshadi")) { id "dp08c-1"; origin case_input; }
    }
    evaluate truth(svyazan(entity_ref("urn:ru:dal:clir:poslovitsy#Makar"), entity_ref("urn:ru:dal:clir:poslovitsy#SdelkaOLoshadi")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
