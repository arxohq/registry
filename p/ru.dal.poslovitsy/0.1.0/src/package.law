// Словарь пакета «Пословицы русского народа»: типы и отношения, которые
// читают ДВА и более нормативных модуля (правило раскладки PACKAGE-LAYOUT).
//
// ЧТО ЗДЕСЬ ФОРМАЛИЗУЕТСЯ. Пословица — не украшение речи, а норма обычного
// права, на которую ссылаются в споре (тот же взгляд — kz.corpus.qara-soz,
// где Абай выносит пословицам поимённые приговоры). Пакет берёт из
// закреплённых разделов Даля те речения, которые несут деонтику, условие или
// санкцию, и записывает КАЖДОЕ правилом с якорем в свою строку сборника.
// Дескриптивная лирика тех же разделов («Правда к Петру и Павлу ушла…»)
// правилами не записывается: выжать из неё норму значило бы выдумать то,
// чего в тексте нет.
//
// ДВА ТИПА НА ВЕСЬ ПАКЕТ. Пословица не различает сословий грамматически —
// статусы (холоп, боярин) и роли (истец, ответчик, судья) несут ФАКТЫ дела,
// а не типы: их источник — утверждения, и §190 связывает носителей норм
// именно фактами. Второй тип — Delo: спор, тяжба или вина, вокруг которых
// строятся процессуальные и карательные максимы.

language "law.core" version "0.1";
package ru.dal.poslovitsy version "0.1.0";
namespace "urn:ru:dal:clir:poslovitsy";

// --- Типы --------------------------------------------------------------------

entity Chelovek {
    label ru official "человек — участник спора, свидетель, владелец, должник";
}

entity Delo {
    label ru official "дело — спор, тяжба либо вина, о которых говорит пословица";
}

// Отношений уровня пакета нет: каждый предикат читается одним модулем, и по
// правилу раскладки живёт при модуле-владельце.
