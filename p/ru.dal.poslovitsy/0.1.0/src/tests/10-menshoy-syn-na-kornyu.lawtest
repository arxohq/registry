language "law.core" version "0.1";
package ru.dal.poslovitsy version "0.1.0";
namespace "urn:ru:dal:clir:poslovitsy";

// Наследство открылось — меньшой сын наследует домом (крестьянская
// ультимогенитура, помета Даля).
test "urn:query:dp-menshoy-syn-na-kornyu" {
    given {
        context { decision_time @2026-08-29T12:00:00Z; knowledge_time @2026-08-29T12:00:00Z; legal_time @1879-06-01; timezone "UTC"; }
        assert menshoy_syn(entity_ref("urn:ru:dal:clir:poslovitsy#Vanka"), entity_ref("urn:ru:dal:clir:poslovitsy#Trofim")) { id "dp10-1"; origin case_input; }
        assert nasledstvo_otkrylos(entity_ref("urn:ru:dal:clir:poslovitsy#Trofim")) { id "dp10-2"; origin case_input; }
    }
    evaluate truth(nasleduet_domom(entity_ref("urn:ru:dal:clir:poslovitsy#Vanka"), entity_ref("urn:ru:dal:clir:poslovitsy#Trofim")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
