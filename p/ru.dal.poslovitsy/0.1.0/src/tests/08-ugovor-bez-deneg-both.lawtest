language "law.core" version "0.1";
package ru.dal.poslovitsy version "0.1.0";
namespace "urn:ru:dal:clir:poslovitsy";

// Встречная пара самого Даля: уговор есть, деньги не плачены. «Уговор дороже
// денег» связывает, «деньги лучше уговора» — нет; приоритета источник не даёт,
// и пакет отвечает BOTH. Это ответ, а не дефект: пословичный фонд — не кодекс
// (приём «Антигоны»).
test "urn:query:dp-ugovor-bez-deneg-both" {
    given {
        context { decision_time @2026-08-29T12:00:00Z; knowledge_time @2026-08-29T12:00:00Z; legal_time @1879-06-01; timezone "UTC"; }
        assert ugovor_zaklyuchen(entity_ref("urn:ru:dal:clir:poslovitsy#Makar"), entity_ref("urn:ru:dal:clir:poslovitsy#Savva"), entity_ref("urn:ru:dal:clir:poslovitsy#SdelkaOLoshadi")) { id "dp08-1"; origin case_input; }
    }
    evaluate truth(svyazan(entity_ref("urn:ru:dal:clir:poslovitsy#Makar"), entity_ref("urn:ru:dal:clir:poslovitsy#SdelkaOLoshadi")));
    expect result_kind == PROPOSITION;
    expect truth_status == BOTH;
    expect evaluation_status == COMPUTED;
}
