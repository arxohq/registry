language "law.core" version "0.1";
package ru.dal.poslovitsy version "0.1.0";
namespace "urn:ru:dal:clir:poslovitsy";

// Осуждённый судом: разрешение «по суду казнят» побеждает общий запрет
// приоритетом lex specialis — казнь допустима.
test "urn:query:dp-osuzhdyonnomu-kazn-dopustima" {
    given {
        context { decision_time @2026-08-29T12:00:00Z; knowledge_time @2026-08-29T12:00:00Z; legal_time @1879-06-01; timezone "UTC"; }
        assert obvinyon(entity_ref("urn:ru:dal:clir:poslovitsy#Emelyan"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloORazboe")) { id "dp01-1"; origin case_input; }
        assert osuzhden_sudom(entity_ref("urn:ru:dal:clir:poslovitsy#Emelyan"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloORazboe")) { id "dp01-2"; origin case_input; }
    }
    evaluate truth(kazn_dopustima(entity_ref("urn:ru:dal:clir:poslovitsy#Emelyan"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloORazboe")));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
