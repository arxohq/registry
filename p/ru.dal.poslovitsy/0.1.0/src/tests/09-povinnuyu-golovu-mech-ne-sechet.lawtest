language "law.core" version "0.1";
package ru.dal.poslovitsy version "0.1.0";
namespace "urn:ru:dal:clir:poslovitsy";

// Виновен, но принёс повинную: вырез lex specialis побеждает общую кару —
// каре не подлежит.
test "urn:query:dp-povinnuyu-golovu-mech-ne-sechet" {
    given {
        context { decision_time @2026-08-29T12:00:00Z; knowledge_time @2026-08-29T12:00:00Z; legal_time @1879-06-01; timezone "UTC"; }
        assert vinoven(entity_ref("urn:ru:dal:clir:poslovitsy#Kuzma"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloOPorube")) { id "dp09-1"; origin case_input; }
        assert povinilsya(entity_ref("urn:ru:dal:clir:poslovitsy#Kuzma"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloOPorube")) { id "dp09-2"; origin case_input; }
    }
    evaluate truth(podlezhit_kare(entity_ref("urn:ru:dal:clir:poslovitsy#Kuzma"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloOPorube")));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
