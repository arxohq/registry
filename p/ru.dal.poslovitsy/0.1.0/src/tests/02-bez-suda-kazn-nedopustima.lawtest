language "law.core" version "0.1";
package ru.dal.poslovitsy version "0.1.0";
namespace "urn:ru:dal:clir:poslovitsy";

// Обвинённый БЕЗ суда: работает только общий запрет «без суда не казнят» —
// казнь недопустима (FALSE_ONLY, а не молчание: пословица запрещает).
test "urn:query:dp-bez-suda-kazn-nedopustima" {
    given {
        context { decision_time @2026-08-29T12:00:00Z; knowledge_time @2026-08-29T12:00:00Z; legal_time @1879-06-01; timezone "UTC"; }
        assert obvinyon(entity_ref("urn:ru:dal:clir:poslovitsy#Emelyan"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloORazboe")) { id "dp02-1"; origin case_input; }
    }
    evaluate truth(kazn_dopustima(entity_ref("urn:ru:dal:clir:poslovitsy#Emelyan"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloORazboe")));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
