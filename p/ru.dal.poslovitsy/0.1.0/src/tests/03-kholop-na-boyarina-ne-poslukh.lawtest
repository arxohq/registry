language "law.core" version "0.1";
package ru.dal.poslovitsy version "0.1.0";
namespace "urn:ru:dal:clir:poslovitsy";

// Холоп свидетельствует против боярина — послух недопустим («Прав.» Яросл.,
// память ст. 66 Пространной Русской Правды).
test "urn:query:dp-kholop-na-boyarina-ne-poslukh" {
    given {
        context { decision_time @2026-08-29T12:00:00Z; knowledge_time @2026-08-29T12:00:00Z; legal_time @1879-06-01; timezone "UTC"; }
        assert kholop(entity_ref("urn:ru:dal:clir:poslovitsy#Grishka")) { id "dp03-1"; origin case_input; }
        assert boyarin(entity_ref("urn:ru:dal:clir:poslovitsy#Morozov")) { id "dp03-2"; origin case_input; }
        assert svidetelstvuet(entity_ref("urn:ru:dal:clir:poslovitsy#Grishka"), entity_ref("urn:ru:dal:clir:poslovitsy#Morozov"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloOPotrave")) { id "dp03-3"; origin case_input; }
    }
    evaluate truth(poslukh(entity_ref("urn:ru:dal:clir:poslovitsy#Grishka"), entity_ref("urn:ru:dal:clir:poslovitsy#Morozov"), entity_ref("urn:ru:dal:clir:poslovitsy#DeloOPotrave")));
    expect result_kind == PROPOSITION;
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
}
