// Допустимость послуха: «Холоп на боярина не послух», «Холоп на холопа
// послух».
//
// ДАЛЬ САМ ДАЁТ ПРОВЕНАНС. Помета «(т. е. не свидетель. «Прав.» Яросл.)»
// возводит первую пословицу к Русской Правде — пословица здесь есть
// НАРОДНАЯ ПАМЯТЬ писаной нормы (ср. ст. 66 Пространной редакции: «а
// послушьства на холопа не складають»). Пакет kz.corpus.russkaya-pravda
// формализует саму Правду; здесь записана её пословичная передача, и это
// разные источники одного правила — расхождение между ними было бы находкой,
// а не дефектом.
//
// СТАТУС — ФАКТ, НЕ ТИП. «Холоп» и «боярин» несут утверждения дела: сословие
// — переменная величина мира, а не сорт сущности (приём statutes-of-apparel:
// сословная матрица — не тип-система).
//
// ПАРА ЗАПИСАНА НЕСИММЕТРИЧНО, И ЭТО ПО ТЕКСТУ. Допустимость («на холопа
// послух») — позитивное strict-правило. Недопустимость («на боярина НЕ
// послух») — defeasible-правило с негативной головой: строгому правилу
// негативная голова в v1 недоступна, а поражаемость здесь безвредна —
// пословица не называет исключений, и никакое правило пакета этот вывод не
// атакует. Тела взаимоисключающи по фактам (свидетельствуемый либо холоп,
// либо боярин), поэтому BOTH на одной подстановке недостижим без
// противоречивого дела.

language "law.core" version "0.1";
package ru.dal.poslovitsy version "0.1.0";
namespace "urn:ru:dal:clir:poslovitsy";

// --- Словарь модуля ----------------------------------------------------------

relation kholop(chelovek: Chelovek) kind empirical {
    label ru official "человек — холоп";
}

relation boyarin(chelovek: Chelovek) kind empirical {
    label ru official "человек — боярин";
}

relation svidetelstvuet(svidetel: Chelovek, protiv: Chelovek, delo: Delo) kind empirical {
    label ru official "человек свидетельствует против другого по делу";
}

relation poslukh(svidetel: Chelovek, protiv: Chelovek, delo: Delo) kind institutional {
    label ru official "свидетель — допустимый послух против названного лица по делу";
}

// --- Холоп на холопа послух --------------------------------------------------

@source(DP_F_KHOLOP_NA_KHOLOPA)
rule KholopNaKholopaPoslukh strict {
    label ru official "Холоп — допустимый послух против холопа";
    for sv: Chelovek; for pr: Chelovek; for d: Delo;
    when kholop(sv) and kholop(pr) and svidetelstvuet(sv, pr, d);
    then poslukh(sv, pr, d);
}

// --- Холоп на боярина не послух ----------------------------------------------

@source(DP_F_KHOLOP_NA_BOYARINA)
rule KholopNaBoyarinaNePoslukh defeasible {
    label ru official "Холоп — недопустимый послух против боярина";
    for sv: Chelovek; for pr: Chelovek; for d: Delo;
    when kholop(sv) and boyarin(pr) and svidetelstvuet(sv, pr, d);
    then not poslukh(sv, pr, d);
}
